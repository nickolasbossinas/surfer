# Copy to .env and adjust. Every setting is optional; the values shown are the defaults.

# Port the app connects to (wss). Also becomes the app's default port when it is
# built, so rebuild the app after changing it.
SURFER_PORT=8686

# Port that serves the APK for installation over plain HTTP.
SURFER_INSTALL_PORT=8687
# Set to 0 to turn the APK download off entirely.
INSTALL_PORT=8687

# Android 2.x app (Xperia X10 and similar): these devices only speak TLS 1.0,
# so they need a second port. Set LEGACY_PORT=8688 to turn it on (0 = off).
# SURFER_LEGACY_PORT is the port on this computer; it also becomes the X10
# app's default port when the app is built.
LEGACY_PORT=0
SURFER_LEGACY_PORT=8688

# End a device's browser session after this many minutes without a connection
# (0 = keep it until the server stops). The device keeps its state either way.
IDLE_STOP_MIN=30

# Languages the browser asks websites for, most preferred first (no q-values).
ACCEPT_LANGUAGE=en-US,en

# Lossless format for still pictures: png or webp.
IDLE_FORMAT=png

# Serve the desktop debug client at https://<server>:<port>/debug/ (1 or 0).
DEBUG_CLIENT=1

# debug, info, warn or error.
LOG_LEVEL=info

# Memory limit for the server container (all browser sessions together).
SURFER_MEM_LIMIT=6g
